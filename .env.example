# WARRANT works with ZERO configuration (offline mode, deterministic sensors).
# Everything below is optional.

# HMAC secret used to sign warrants. A fixed demo secret is used if unset.
WARRANT_SECRET=change-me-in-production

# "offline" (default) = rule-based sensors only. "llm" = add LLM extractor + pre-mortem.
WARRANT_MODE=offline

# Needed only for WARRANT_MODE=llm (Vercel AI Gateway).
AI_GATEWAY_API_KEY=
WARRANT_LLM_MODEL=anthropic/claude-haiku-5-5
